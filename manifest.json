{
  "manifest_version": 3,
  "name": "SmartSniper Pro",
  "version": "2.1.0",
  "description": "Coupon, cashback e arbitraggio — affiliate-first, ROI netto reale, auto-apply checkout.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SmartSniper Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "declarativeNetRequest",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.smartsniper.pro/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "file://*/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "affiliate_safety",
        "enabled": true,
        "path": "rules/affiliate_safety.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.it/*",
        "https://*.amazon.com/*",
        "https://*.amazon.de/*",
        "https://*.ebay.it/*",
        "https://*.ebay.com/*",
        "https://*.zalando.it/*",
        "https://*.zalando.com/*",
        "https://*.mediaworld.it/*",
        "https://*.unieuro.it/*",
        "https://*/*checkout*",
        "https://*/*cart*",
        "https://*/*basket*",
        "http://*/*checkout*",
        "http://*/*cart*",
        "http://*/*basket*",
        "http://127.0.0.1/*",
        "http://localhost/*",
        "file://*/*"
      ],
      "js": [
        "utils/affiliate.js",
        "utils/api-client.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "demo/*",
        "content/content.css",
        "utils/*"
      ],
      "matches": [
        "<all_urls>",
        "file://*/*"
      ]
    }
  ]
}
