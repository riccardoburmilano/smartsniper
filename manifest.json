{
  "manifest_version": 3,
  "name": "SmartSniper Pro",
  "version": "1.0.0",
  "description": "Coupon auto-apply, cashback e arbitraggio con ROI netto reale — affiliate-first.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SmartSniper Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "file://*/*",
    "https://*.amazon.it/*",
    "https://*.amazon.com/*",
    "https://*.ebay.it/*",
    "https://*.ebay.com/*",
    "https://*.zalando.it/*",
    "https://*.zalando.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.it/*",
        "https://*.amazon.com/*",
        "https://*.ebay.it/*",
        "https://*.ebay.com/*",
        "https://*.zalando.it/*",
        "https://*.zalando.com/*",
        "https://*/*checkout*",
        "https://*/*cart*",
        "http://*/*checkout*",
        "http://*/*cart*",
        "http://127.0.0.1/*",
        "http://localhost/*",
        "file://*/*"
      ],
      "js": [
        "utils/affiliate.js",
        "utils/api-client.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "content/content.css",
        "utils/*",
        "demo/*"
      ],
      "matches": [
        "<all_urls>",
        "file://*/*"
      ]
    }
  ]
}
