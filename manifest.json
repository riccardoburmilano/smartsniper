{
  "manifest_version": 3,
  "name": "SmartSniper",
  "version": "1.0.0",
  "description": "Rileva coupon/cashback al checkout e monitora i prezzi in background per opportunità di risparmio e arbitraggio.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SmartSniper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "file://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.it/*",
        "https://*.amazon.com/*",
        "https://*.amazon.de/*",
        "https://*.ebay.it/*",
        "https://*.ebay.com/*",
        "https://*.zalando.it/*",
        "https://*.zalando.com/*",
        "https://*.mediaworld.it/*",
        "https://*.unieuro.it/*",
        "https://*/*checkout*",
        "https://*/*cart*",
        "https://*/*basket*",
        "http://*/*checkout*",
        "http://*/*cart*",
        "http://*/*basket*",
        "http://127.0.0.1/*",
        "http://localhost/*",
        "file://*/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "demo/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
